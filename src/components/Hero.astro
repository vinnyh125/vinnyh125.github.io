<section
  id="hero"
  data-pc="on"
  class="group relative min-h-screen flex items-center px-6 pt-20 pb-24 md:pt-16 md:pb-16"
>
  <div class="mx-auto w-full max-w-6xl grid items-center gap-4 md:grid-cols-2 md:gap-8 md:group-data-[pc=off]:grid-cols-1">
    <div class="flex flex-col items-center gap-4 text-center md:items-start md:text-left md:group-data-[pc=off]:items-center md:group-data-[pc=off]:text-center">
      <p class="text-xs tracking-widest uppercase text-accent" data-hero-text style="--i: 0">
        Hello, I'm
      </p>
      <h1
        class="text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight text-text"
        data-hero-text
        style="--i: 1"
      >
        Vincent Huang
      </h1>
      <p class="text-sm tracking-widest uppercase text-muted mt-1" data-hero-text style="--i: 2">
        Software Engineer &middot; Cornell CS '26
      </p>

      <div class="flex items-center gap-6 mt-6" data-hero-text style="--i: 3">
        <a
          href="https://github.com/vinnyh125"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-accent transition-colors duration-200"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/vinny-huang/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-accent transition-colors duration-200"
          aria-label="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href="https://drive.google.com/file/d/18gIneW-Hn-GyQI5EaESbNuw77jwel6DV/view?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs tracking-widest uppercase border border-border px-4 py-2 text-muted hover:text-accent hover:border-accent transition-colors duration-200"
        >
          Resume
        </a>
      </div>
    </div>

    <!-- Three.js PC build mounts here (see src/scripts/pc/scene.ts) -->
    <div
      id="pc-stage"
      aria-hidden="true"
      class="order-first h-[42vh] w-full md:order-none md:h-[70vh] group-data-[pc=off]:hidden"
    ></div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2" data-hero-text style="--i: 4">
    <a
      href="#experience"
      class="block text-muted hover:text-accent transition-colors duration-200 animate-bounce"
      aria-label="Scroll down"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </a>
  </div>
</section>

<script>
  const hero = document.getElementById('hero')!;
  const stage = document.getElementById('pc-stage')!;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Dev-only `?pcTime=2.5` freezes the build at that second, for checking poses
  const freezeParam = import.meta.env.DEV ? new URLSearchParams(location.search).get('pcTime') : null;
  const freezeAt = freezeParam === null ? undefined : Number(freezeParam);

  let revealed = false;
  function revealText() {
    if (revealed) return;
    revealed = true;
    hero.querySelectorAll('[data-hero-text]').forEach((el) => el.classList.add('revealed'));
  }

  function disable3d() {
    hero.dataset.pc = 'off';
    revealText();
  }

  function supportsWebGL2() {
    try {
      const gl = document.createElement('canvas').getContext('webgl2');
      gl?.getExtension('WEBGL_lose_context')?.loseContext();
      return !!gl;
    } catch {
      return false;
    }
  }

  if (reducedMotion) revealText();

  if (!supportsWebGL2()) {
    disable3d();
  } else {
    // Never leave the hero blank, e.g. if the page loaded scrolled past it and the build is paused
    setTimeout(revealText, 6000);
    import('../scripts/pc/scene')
      .then(({ mountPcScene }) => mountPcScene(stage, { onBoot: revealText, reducedMotion, freezeAt }))
      .catch((err) => {
        console.error('PC scene failed to load', err);
        disable3d();
      });
  }
</script>
